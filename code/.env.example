# Local: cp .env.example backend/.env  (gitignored; `make dev` loads it)
# Deployed: the integrator adds the same keys to the *-api Vercel project (Settings → Environment Variables).
# Never commit real keys. Tests must not need them.
OPENAI_API_KEY=  # required: personas, debriefs and live interviews
OPENAI_MODEL=  # optional, default gpt-5.4-mini
OPENAI_REALTIME_MODEL=  # optional, default gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=  # optional, default follows the persona's gender
UPSTASH_REDIS_REST_URL=  # required: stores personas, sessions and transcripts
UPSTASH_REDIS_REST_TOKEN=  # required: stores personas, sessions and transcripts
SIMLI_API_KEY=  # required for the avatar; without it the avatar token endpoint returns 503
SIMLI_FACE_ID=  # optional, default is a Simli preset face; used only when a persona has no face
DEMO_PASSCODE=  # required on Vercel, leave empty locally
RATE_LIMIT_MULTIPLIER=  # optional, default 1; raise it (e.g. 5) to loosen all rate limits on demo day
