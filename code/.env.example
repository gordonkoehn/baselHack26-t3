# Local: cp .env.example backend/.env  (gitignored; `make dev` loads it)
# Deployed: the integrator adds the same keys to the *-api Vercel project (Settings → Environment Variables).
# Never commit real keys. Tests must not need them.
OPENAI_API_KEY=  # required for extraction and debrief
OPENAI_MODEL=  # optional, default gpt-5.4-mini
OPENAI_REALTIME_MODEL=  # optional, default gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=  # optional, default marin
SIMLI_API_KEY=  # required for avatar playback
SIMLI_FACE_ID=  # optional, default Simli face
PERSONA_FACE_ID=  # optional, persona-specific Simli face
PERSONA_VOICE_ID=  # optional, persona-specific voice
UPSTASH_REDIS_REST_URL=  # required when the Redis-backed store is enabled
UPSTASH_REDIS_REST_TOKEN=  # required when the Redis-backed store is enabled
