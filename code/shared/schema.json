{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "baselhack26 API contracts",
  "description": "Source of truth for data shapes between frontend and backend. Agree on this FIRST, then build both sides in parallel. Mirrors: code/backend/app/contracts.py, code/frontend/src/lib/contracts.ts. Examples in code/shared/examples/. Endpoints marked status=draft are agreed but not implemented yet.",
  "$defs": {
    "Label": {
      "description": "grounded = backed by an Evidence entry; guess = invented by the model, must be shown as a guess.",
      "enum": ["grounded", "guess"]
    },
    "SourceKind": { "enum": ["transcript", "miro", "note", "real_interview"] },
    "Evidence": {
      "type": "object",
      "required": ["id", "kind", "claim"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "$ref": "#/$defs/SourceKind" },
        "claim": { "type": "string" },
        "quote": { "type": ["string", "null"], "description": "Verbatim text from the source." },
        "sourceRef": { "type": ["string", "null"], "description": "e.g. transcript id, Miro sticky id." }
      }
    },
    "Fact": {
      "type": "object",
      "required": ["text", "label", "evidenceId"],
      "properties": {
        "text": { "type": "string" },
        "label": { "$ref": "#/$defs/Label" },
        "evidenceId": { "type": ["string", "null"], "description": "Set when label is grounded, null for a guess." }
      }
    },
    "Scale5": { "type": "integer", "minimum": 1, "maximum": 5 },
    "Persona": {
      "type": "object",
      "required": ["id", "name", "language", "summary", "jobs", "pains", "objections", "voiceId", "faceId", "cloned", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "sprintId": { "type": ["string", "null"] },
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "age": { "type": ["integer", "null"] },
        "location": { "type": ["string", "null"] },
        "language": { "enum": ["de", "en"], "description": "Spoken language. No provider speaks Swiss German; Swiss flavour goes in speechStyle.notes." },
        "summary": { "type": "string" },
        "context": {
          "type": "object",
          "properties": {
            "job": { "type": ["string", "null"] },
            "household": { "type": ["string", "null"] },
            "toolsToday": { "type": "array", "items": { "type": "string" } }
          }
        },
        "jobs": { "type": "array", "items": { "$ref": "#/$defs/Fact" } },
        "pains": { "type": "array", "items": { "$ref": "#/$defs/Fact" } },
        "objections": {
          "type": "array",
          "items": { "$ref": "#/$defs/Fact" },
          "description": "Reasons this persona would say no. Fed to the prompt against sycophancy."
        },
        "attitudes": {
          "type": "object",
          "properties": {
            "techAffinity": { "$ref": "#/$defs/Scale5" },
            "priceSensitivity": { "$ref": "#/$defs/Scale5" },
            "trustInNewBrands": { "$ref": "#/$defs/Scale5" }
          }
        },
        "speechStyle": {
          "type": "object",
          "properties": {
            "register": { "enum": ["formal", "informal"] },
            "verbosity": { "enum": ["short", "medium", "long"] },
            "fillers": { "type": "boolean" },
            "notes": { "type": ["string", "null"], "description": "e.g. Helvetisms to use." }
          }
        },
        "voiceId": { "type": "string", "description": "Provider voice id (stock unless cloned)." },
        "faceId": { "type": "string", "description": "Provider avatar/replica id." },
        "cloned": { "type": "boolean", "description": "true only with written consent of the real person." },
        "readiness": {
          "type": ["object", "null"],
          "description": "Measured once at creation: consistency is the share of probe questions both runs answered alike, grounding the share of answers relying mainly on grounded facts, score their product. null if the check failed or the persona was edited since.",
          "required": ["score", "consistency", "grounding"],
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 1 },
            "consistency": { "type": "number", "minimum": 0, "maximum": 1 },
            "grounding": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/Evidence" } }
      }
    },
    "PersonaSummary": {
      "type": "object",
      "description": "One row of the persona library: enough to recognise a persona, none of its facts or evidence.",
      "required": ["id", "name", "role", "createdAt", "readiness"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": ["string", "null"], "description": "The persona's context.job." },
        "createdAt": { "type": "string", "format": "date-time" },
        "readiness": { "$ref": "#/$defs/Persona/properties/readiness" }
      }
    },
    "PersonaUpdate": {
      "type": "object",
      "description": "Human edits before the interview. Lists given replace the stored ones; absent fields stay. A fact stays grounded only if the same text and evidenceId were already grounded in that list; edited or new facts become guesses. Bumps version and clears readiness.",
      "properties": {
        "jobs": { "type": "array", "items": { "$ref": "#/$defs/Fact" } },
        "pains": { "type": "array", "items": { "$ref": "#/$defs/Fact" } },
        "objections": { "type": "array", "items": { "$ref": "#/$defs/Fact" } },
        "speechStyle": {
          "type": "object",
          "properties": { "notes": { "type": ["string", "null"] } }
        }
      }
    },
    "PersonaSource": {
      "type": "object",
      "required": ["kind", "text"],
      "properties": {
        "kind": { "$ref": "#/$defs/SourceKind" },
        "title": { "type": ["string", "null"] },
        "text": { "type": "string", "description": "Pasted content. Vercel caps request bodies at 4.5 MB; larger files go to blob storage first." }
      }
    },
    "ExtractedText": {
      "type": "object",
      "description": "Plain text pulled from an uploaded file, to be sent as a PersonaSource. PDFs without a text layer (scans) and images are transcribed by the vision model (images: pages is 1).",
      "required": ["text", "pages"],
      "properties": {
        "text": { "type": "string" },
        "pages": { "type": "integer", "minimum": 1 }
      }
    },
    "PersonaCreate": {
      "type": "object",
      "required": ["language", "sources"],
      "properties": {
        "sprintId": { "type": ["string", "null"] },
        "language": { "enum": ["de", "en"] },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/PersonaSource" } }
      }
    },

    "GuideIssue": {
      "description": "Mom Test problems: leading = suggests the wanted answer; hypothetical = asks about imagined behaviour; closed = answerable with yes or no; pitch = sells the idea.",
      "enum": ["leading", "hypothetical", "closed", "pitch"]
    },
    "GuideReviewRequest": {
      "type": "object",
      "required": ["questions", "language"],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "type": "string", "pattern": "\\S", "maxLength": 500, "description": "Surrounding whitespace is ignored." }
        },
        "language": { "enum": ["de", "en"], "description": "Language of the rewrites." }
      }
    },
    "GuideReview": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "description": "One entry per question, in request order.",
          "items": {
            "type": "object",
            "required": ["question", "issues", "rewrite"],
            "properties": {
              "question": { "type": "string" },
              "issues": { "type": "array", "items": { "$ref": "#/$defs/GuideIssue" } },
              "rewrite": { "type": ["string", "null"], "description": "Neutral, open version on one line. Null when there are no issues." }
            }
          }
        }
      }
    },

    "Provider": { "enum": ["openai-realtime", "simli"], "description": "Which realtime vendor the browser joins." },
    "Session": {
      "type": "object",
      "required": ["id", "personaId", "status", "provider"],
      "properties": {
        "id": { "type": "string" },
        "personaId": { "type": "string" },
        "status": { "enum": ["created", "live", "ended"] },
        "provider": { "$ref": "#/$defs/Provider" },
        "joinUrl": { "type": ["string", "null"], "description": "URL the browser connects to, if any." },
        "interviewGuide": { "type": "array", "items": { "type": "string" } },
        "readySeconds": { "type": ["number", "null"], "description": "Sources submitted to persona interview-ready." },
        "startedAt": { "type": ["string", "null"], "format": "date-time" },
        "endedAt": { "type": ["string", "null"], "format": "date-time" },
        "debriefReady": { "type": "boolean", "description": "Whether a saved debrief can be opened. Only in GET /api/personas/{id}/sessions." },
        "sample": { "type": "boolean", "description": "Demo fallback: a scripted transcript with no live call. Every view of its debrief must say so." }
      }
    },
    "SessionCreate": {
      "type": "object",
      "required": ["personaId"],
      "properties": {
        "personaId": { "type": "string" },
        "interviewGuide": { "type": "array", "items": { "type": "string" }, "description": "Sprint questions the coach tracks coverage for." },
        "sample": { "type": "boolean", "description": "See Session.sample." }
      }
    },
    "SessionUpdate": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["live", "ended"], "description": "created -> live -> ended, or created -> ended. Repeating the current status is a no-op; going back is 409." }
      }
    },
    "SessionToken": {
      "type": "object",
      "required": ["provider", "expiresAt"],
      "properties": {
        "provider": { "$ref": "#/$defs/Provider" },
        "token": { "type": ["string", "null"], "description": "Short-lived client token. Never a long-lived API key." },
        "url": { "type": ["string", "null"] },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },

    "SessionEvent": {
      "description": "The browser posts these in small batches (no WebSocket in our backend). seq is per session, assigned by the client, monotonic.",
      "type": "object",
      "required": ["sessionId", "seq", "at", "type", "data"],
      "properties": {
        "sessionId": { "type": "string" },
        "seq": { "type": "integer", "minimum": 1 },
        "at": { "type": "string", "format": "date-time" },
        "type": { "enum": ["utterance", "screen.caption", "twin.reaction", "copilot.suggestion", "session.ended"] },
        "data": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "utterance" } } },
          "then": { "properties": { "data": {
            "type": "object",
            "required": ["speaker", "text"],
            "properties": {
              "speaker": { "enum": ["interviewer", "persona"] },
              "text": { "type": "string" },
              "tStart": { "type": ["number", "null"], "description": "Seconds since session start." },
              "tEnd": { "type": ["number", "null"] }
            }
          } } }
        },
        {
          "if": { "properties": { "type": { "const": "screen.caption" } } },
          "then": { "properties": { "data": {
            "type": "object",
            "required": ["caption", "source"],
            "properties": {
              "caption": { "type": "string", "description": "Neutral description of what is on screen. Frames themselves are never stored." },
              "source": { "enum": ["vision", "dom"] }
            }
          } } }
        },
        {
          "if": { "properties": { "type": { "const": "twin.reaction" } } },
          "then": { "properties": { "data": {
            "type": "object",
            "required": ["kind", "intensity"],
            "properties": {
              "kind": { "enum": ["confused", "pleased", "sceptical"] },
              "intensity": { "$ref": "#/$defs/Scale5" }
            }
          } } }
        },
        {
          "if": { "properties": { "type": { "const": "copilot.suggestion" } } },
          "then": { "properties": { "data": {
            "type": "object",
            "required": ["kind", "text"],
            "properties": {
              "kind": { "enum": ["leading_question", "pitching", "follow_up", "coverage"] },
              "text": { "type": "string" },
              "turnSeq": { "type": ["integer", "null"], "description": "seq of the interviewer utterance this refers to." }
            }
          } } }
        },
        {
          "if": { "properties": { "type": { "const": "session.ended" } } },
          "then": { "properties": { "data": {
            "type": "object",
            "properties": { "durationSeconds": { "type": "number" } }
          } } }
        }
      ]
    },

    "Insight": {
      "type": "object",
      "required": ["id", "theme", "quote", "turnSeq", "label", "evidenceId"],
      "properties": {
        "id": { "type": "string" },
        "theme": { "type": "string" },
        "quote": { "type": "string", "description": "Must match the transcript word for word." },
        "turnSeq": { "type": "integer" },
        "label": { "$ref": "#/$defs/Label" },
        "evidenceId": { "type": ["string", "null"] }
      }
    },
    "InsightReport": {
      "type": "object",
      "required": ["sessionId", "generatedAt", "questions"],
      "properties": {
        "sessionId": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["question", "signal", "insights"],
            "properties": {
              "question": { "type": "string" },
              "signal": { "enum": ["supports", "contradicts", "unclear"] },
              "insights": { "type": "array", "items": { "$ref": "#/$defs/Insight" } },
              "followUps": { "type": "array", "items": { "type": "string" }, "description": "Questions to ask real customers." }
            }
          }
        }
      }
    },
    "InsightSummaryRequest": {
      "type": "object",
      "required": ["sessionIds"],
      "properties": {
        "sessionIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "type": "string" },
          "description": "Interviews to compare. A repeated id counts once."
        }
      }
    },
    "InsightSummary": {
      "type": "object",
      "description": "Saved debriefs side by side, computed without a model. Questions are grouped by exact text, in order of first appearance.",
      "required": ["questions"],
      "properties": {
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["question", "supports", "contradicts", "unclear", "insights"],
            "properties": {
              "question": { "type": "string" },
              "supports": { "type": "integer", "minimum": 0, "description": "Interviews with this signal. An interview whose guide lacks the question counts in none of the three." },
              "contradicts": { "type": "integer", "minimum": 0 },
              "unclear": { "type": "integer", "minimum": 0 },
              "insights": {
                "type": "array",
                "description": "Strongest quotes: at most two per interview, so none is left out, with grounded ones first.",
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/Insight" },
                    {
                      "type": "object",
                      "required": ["sessionId"],
                      "properties": { "sessionId": { "type": "string", "description": "The interview this quote is from." } }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "endpoints": {
    "GET /api/health": { "response": { "status": "ok" } },
    "POST /api/personas": { "body": "PersonaCreate", "response": "Persona", "status": "draft" },
    "GET /api/personas": { "response": "PersonaSummary[]", "note": "Newest first, max 20. An edit (PATCH) keeps a persona's place and createdAt. Needs the demo passcode (X-Demo-Passcode, 401 without it): the list exposes the ids that GET /api/personas/{id} reads. 503 store unavailable." },
    "GET /api/personas/{id}": { "response": "Persona", "status": "draft" },
    "PATCH /api/personas/{id}": { "body": "PersonaUpdate", "response": "Persona", "note": "404 unknown persona. Only labels can be downgraded: grounded needs an unchanged grounded fact." },
    "GET /api/personas/{id}/sessions": { "response": "Session[]", "note": "A persona's interviews, newest first, max 50, each with debriefReady. Includes sessions that never started (startedAt null). Needs the demo passcode (X-Demo-Passcode, 401 without it): a shared report link reveals its persona id, and this list would hand over the ids of that persona's other interviews. 404 unknown persona, 503 store unavailable." },
    "POST /api/sources/pdf": { "body": "raw PDF bytes (Content-Type: application/pdf, max 10 MB)", "response": "ExtractedText", "status": "draft", "note": "Text layer first; scanned PDFs (no text layer, max 20 pages) are transcribed by the vision model. 413 over 10 MB, 100 pages (20 if scanned) or 200,000 characters (never truncated); 422 not a PDF, corrupt, password protected or no readable text; 502/503 transcription failed or provider unavailable." },
    "POST /api/sources/image": { "body": "raw PNG, JPEG, WebP or GIF bytes (max 10 MB, format sniffed from the bytes)", "response": "ExtractedText", "status": "draft", "note": "Visible text transcribed verbatim by the vision model. 413 over 10 MB or 200,000 characters; 422 not a supported image or no readable text; 502 unusable transcription; 503 provider unavailable." },
    "POST /api/guides/review": { "body": "GuideReviewRequest", "response": "GuideReview", "note": "Stateless Mom Test check of an interview guide. Passcode required. 422 invalid body; 502 unusable model output; 503 provider unavailable." },
    "POST /api/sessions": { "body": "SessionCreate", "response": "Session", "status": "draft", "note": "Needs the demo passcode (X-Demo-Passcode, 401 without it): a new session takes a place in GET /api/personas/{id}/sessions, and a persona id alone must not be enough to push real interviews out of that list." },
    "GET /api/sessions/{id}": { "response": "Session", "status": "draft" },
    "PATCH /api/sessions/{id}": { "body": "SessionUpdate", "response": "Session", "status": "draft" },
    "POST /api/sessions/{id}/token": { "response": "SessionToken", "status": "draft" },
    "POST /api/sessions/{id}/avatar-token": { "response": "SessionToken", "status": "draft", "note": "provider simli: short-lived Simli session token for the persona's face (SIMLI_API_KEY stays server-side), url null. 404 unknown session/persona, 409 after ended, 503 Simli unavailable or not configured." },
    "POST /api/sessions/{id}/events": { "body": "SessionEvent[]", "response": { "accepted": "integer" }, "status": "draft" },
    "GET /api/sessions/{id}/events?after={seq}": { "response": "SessionEvent[]", "status": "draft", "note": "Polling replaces the spec's WS /sessions/{id}/events." },
    "POST /api/sessions/{id}/coach": { "body": "{ turnSeq }", "response": "SessionEvent (copilot.suggestion)", "status": "draft" },
    "POST /api/sessions/{id}/debrief": { "response": "InsightReport", "status": "draft" },
    "GET /api/sessions/{id}/insights": { "response": "InsightReport", "status": "draft" },
    "POST /api/insights/summary": { "body": "InsightSummaryRequest", "response": "InsightSummary", "note": "No passcode, like GET /api/sessions/{id}/insights: it never calls a model and only returns what those ids can already read. 404 if any interview has no saved debrief (never a partial count), 422 for no ids or more than 50, 503 store unavailable." }
  }
}
